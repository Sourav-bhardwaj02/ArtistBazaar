#!/bin/bash
# Pre-commit hook to scan staged files for exposed secrets (API keys, MongoDB credentials, tokens)

# Redirect output to stderr
exec 1>&2

# Define color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0;0m' # No Color

echo -e "${BLUE}🔍 Scanning staged files for secrets...${NC}"

# Get list of staged files (excluding deletions)
staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
    echo -e "${GREEN}✅ No staged files to scan.${NC}"
    exit 0
fi

# Define secret patterns to scan for (Regex)
# 1. Google API Key (starts with AIzaSy)
GOOGLE_API_KEY_REGEX="AIzaSy[A-Za-z0-9_-]{33}"

# 2. MongoDB connection string with credentials (username:password@host)
MONGODB_CREDS_REGEX="mongodb(\+srv)?://[a-zA-Z0-9_.-]+:[a-zA-Z0-9_.-]+@"

# 3. AWS Access Key ID
AWS_KEY_REGEX="(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}"

# 4. Stripe API Key
STRIPE_KEY_REGEX="sk_live_[0-9a-zA-Z]{24}"

# 5. Slack Token
SLACK_TOKEN_REGEX="xox[bapr]-[0-9]{12}-[0-9]{12}-[a-zA-Z0-9]{24}"

# 6. Generic Private Keys
PRIVATE_KEY_REGEX="-----BEGIN [A-Z ]*PRIVATE KEY-----"

# 7. Generic password/secret assignments (e.g. const api_key = "...", but ignoring env files)
GENERIC_SECRET_REGEX="(api_key|client_secret|db_password|jwt_secret|razorpay_secret|cloudinary_secret)[[:space:]]*=[[:space:]]*['\"][a-zA-Z0-9_.-]{12,}['\"]"

LEAKS_FOUND=0

for file in $staged_files; do
    # Skip directories or non-files
    if [ ! -f "$file" ]; then
        continue
    fi

    # Ignore .env files and env.example files
    if [[ "$file" == *".env"* || "$file" == *"env.example"* || "$file" == *"package-lock.json"* || "$file" == *"bun.lockb"* ]]; then
        continue
    fi

    # Check for each secret pattern using grep
    # We use git diff --cached -S or grep on the staged content to avoid matching unstaged lines
    
    # Extract the staged content of the file
    staged_content=$(git show :"$file")

    # Helper function to scan staged content for a pattern
    scan_pattern() {
        local pattern="$1"
        local description="$2"
        
        # Check using grep with -i for case insensitivity
        local matches
        matches=$(echo "$staged_content" | grep -E -i -n "$pattern" 2>/dev/null)
        
        if [ ! -z "$matches" ]; then
            echo -e "${RED}❌ Leaked Secret Detected in '$file': [Type: $description]${NC}"
            echo -e "$matches" | while read -r line; do
                echo -e "   Line $line"
            done
            LEAKS_FOUND=$((LEAKS_FOUND + 1))
        fi
    }

    scan_pattern "$GOOGLE_API_KEY_REGEX" "Google API Key"
    scan_pattern "$MONGODB_CREDS_REGEX" "MongoDB URI with Credentials"
    scan_pattern "$AWS_KEY_REGEX" "AWS API Key"
    scan_pattern "$STRIPE_KEY_REGEX" "Stripe API Key"
    scan_pattern "$SLACK_TOKEN_REGEX" "Slack Token"
    scan_pattern "$PRIVATE_KEY_REGEX" "Private Key Block"
    scan_pattern "$GENERIC_SECRET_REGEX" "Hardcoded Config Secret"
done

if [ "$LEAKS_FOUND" -gt 0 ]; then
    echo -e "\n${RED}🚨 Commit blocked! The scan detected $LEAKS_FOUND potential secrets in your staged changes.${NC}"
    echo -e "${YELLOW}Please remove these secrets from your code, move them to a .env file, and stage the files again.${NC}"
    echo -e "${YELLOW}If this is a false positive and you absolutely need to commit this, use: git commit --no-verify${NC}\n"
    exit 1
else
    echo -e "${GREEN}✅ Secret scan passed. No secrets detected in staged files.${NC}"
    exit 0
fi
